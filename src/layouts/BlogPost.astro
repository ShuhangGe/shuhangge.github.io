---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	langSwitchHref?: string;
	langLabel?: string;
};

const { title, description, pubDate, updatedDate, heroImage, langSwitchHref, langLabel } = Astro.props;
---

<html lang={Astro.props.lang === 'zh' ? 'zh-CN' : 'en'}>
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				border: 1px solid rgba(0, 0, 0, 0.08);
				box-shadow: var(--shadow-card);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 2em 1em;
				color: var(--text-secondary);
			}
			.title-block {
				margin-bottom: 2em;
				padding: 2em 0 1.5em;
				border-bottom: 1px solid rgba(0, 0, 0, 0.06);
			}
			.title-block h1 {
				margin: 0 0 0.75em 0;
				font-size: 2.25rem;
				font-weight: 600;
				letter-spacing: -0.5px;
				line-height: 1.15;
			}
			.meta {
				display: flex;
				align-items: center;
				gap: 1em;
				flex-wrap: wrap;
			}
			.date {
				color: var(--text-muted);
				font-size: 0.875rem;
				font-weight: 400;
			}
			.last-updated-on {
				font-style: italic;
				color: var(--text-muted);
				font-size: 0.8125rem;
			}
			.lang-switch {
				font-size: 0.8125rem;
			}
			.lang-switch a {
				color: var(--text-tertiary);
				text-decoration: none;
				padding: 4px 10px;
				border-radius: 6px;
				border: 1px solid rgba(0, 0, 0, 0.1);
				transition: all 0.15s ease;
			}
			.lang-switch a:hover {
				color: var(--text-primary);
				border-color: rgba(0, 0, 0, 0.2);
				background: rgba(0, 0, 0, 0.03);
			}
			.tags {
				display: flex;
				gap: 6px;
				flex-wrap: wrap;
				margin-top: 1em;
			}
			.tag {
				display: inline-block;
				background: rgba(94, 106, 210, 0.08);
				color: var(--accent);
				padding: 3px 10px;
				border-radius: 9999px;
				font-size: 0.75rem;
				font-weight: 500;
				letter-spacing: 0.02em;
			}
			.giscus-container {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 2em auto;
				padding: 1em;
			}
		</style>
	</head>

	<body>
		<Header lang={Astro.props.lang} />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					{langSwitchHref && (
						<div class="lang-switch">
							<a href={langSwitchHref}>{langLabel}</a>
						</div>
					)}
					<div class="title-block">
						<h1>{title}</h1>
						<div class="meta">
							<div class="date">
								<FormattedDate date={pubDate} />
								{updatedDate && (
									<span class="last-updated-on">
										&nbsp;· Updated <FormattedDate date={updatedDate} />
									</span>
								)}
							</div>
						</div>
						{Astro.props.tags && (
							<div class="tags">
								{Astro.props.tags.map((tag: string) => (
									<span class="tag">{tag}</span>
								))}
							</div>
						)}
					</div>
					<slot />
				</div>
				<div class="giscus-container">
					<script
						src="https://giscus.app/client.js"
						data-repo="ShuhangGe/shuhangge.github.io"
						data-repo-id="R_kgDOST1ikA"
						data-category="General"
						data-category-id="DIC_kwDOST1ikM4C8Tq5"
						data-mapping="pathname"
						data-strict="0"
						data-reactions-enabled="1"
						data-emit-metadata="0"
						data-input-position="top"
						data-theme="light"
						data-lang={Astro.props.lang === 'zh' ? 'zh-CN' : 'en'}
						data-loading="lazy"
						async
					></script>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
