---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p>&copy; {today.getFullYear()} Agent Architecture Daily. Built with Astro.</p>
		<div class="footer-links">
			<a href="https://github.com/ShuhangGe/shuhangge.github.io" target="_blank">Source</a>
			<span class="divider">·</span>
			<a href="https://shuhangge.github.io/zh/blog">Archive</a>
		</div>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid rgba(0, 0, 0, 0.06);
		background: var(--bg-panel);
	}

	.footer-inner {
		max-width: 960px;
		margin: 0 auto;
		padding: 1.5em 1.5em;
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 0.8125rem;
		color: var(--text-muted);
	}

	.footer-inner p {
		margin: 0;
	}

	.footer-links {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.footer-links a {
		color: var(--text-tertiary);
		transition: color 0.15s ease;
	}

	.footer-links a:hover {
		color: var(--text-primary);
	}

	.divider {
		color: var(--text-muted);
	}

	@media (max-width: 720px) {
		.footer-inner {
			flex-direction: column;
			gap: 0.5em;
			text-align: center;
		}
	}
</style>
