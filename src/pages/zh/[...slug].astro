---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => data.lang === 'zh');
	return posts.map((post) => ({
		params: { slug: post.id.replace(/^zh\//, '') },
		props: post,
	}));
}

type Props = CollectionEntry<'blog'>;
const post = Astro.props;
const { Content } = await render(post);

// Find EN counterpart
const enPosts = await getCollection('blog', ({ data }) => data.lang === 'en');
const enSlug = post.id.replace(/^zh\//, '');
const enCounterpart = enPosts.find((p) => p.id === `en/${enSlug}`);
---

<BlogPost {...post.data} langSwitchHref={enCounterpart ? `/en/${enSlug}/` : undefined} langLabel="English">
	<Content />
</BlogPost>
